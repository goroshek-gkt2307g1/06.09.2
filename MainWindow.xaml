<Window x:Class="_06._09._2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_06._09._2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <LinearGradientBrush x:Key="OwnBrush">
            <GradientStop Color="Red" Offset="0"/>
            <GradientStop Color="Green" Offset="0.5"/>
            <GradientStop Color="Purple" Offset="1"/>
        </LinearGradientBrush>
        <!--<Style TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=t1, Path=Text}" Value="">
                    <DataTrigger.Setters>
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger.Setters>
                </DataTrigger>
            </Style.Triggers>
        </Style> -->
        <Style TargetType="Button">
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition 
                    </MultiTrigger.Conditions>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="Open">Открыть</Button>
            <Button x:Name="Clear">Очистить</Button>
            <Button x:Name="Close">Закрыть</Button>

            <ComboBox>
                <ComboBoxItem x:Name="st1">
                    <TextBlock>1 стиль</TextBlock>
                </ComboBoxItem>
                <ComboBoxItem>
                    <TextBlock>2 стиль</TextBlock>
                </ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <TextBox x:Name="t1" Background="{StaticResource OwnBrush}" />
        <TextBox x:Name="t2" Background="{Binding ElementName=t1, Path=Background}"/>
    </StackPanel>
    
</Window>
